# 复制本文件为 .env 并填入真实密钥（.env 已被 .gitignore 排除，勿提交）
# LLM 服务（默认 DeepSeek，OpenAI 兼容接口，可换成任意兼容服务）
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_API_BASE=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Embedding 模型（本地运行，无需密钥）
EMBEDDING_MODEL=shibing624/text2vec-base-chinese
# 1 = 仅用本地缓存（无外网也能跑）；0 = 允许联网下载新模型
EMBEDDING_LOCAL_ONLY=1

# 数据路径
DATA_PATH=./_message_list.json
DB_DIR=./medical_db

# 检索与切块参数
RETRIEVAL_K=5
CHUNK_SIZE=600
CHUNK_OVERLAP=60

# 评测参数
QUERY_SET_SIZE=200
RANDOM_SEED=42
